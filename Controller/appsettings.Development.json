{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "RateLimiting": {
    "PermitLimit": 1000,
    "QueueLimit": 0,
    "WindowMinutes": 1
  },
  "Jwt": {
    "Issuer": "Fileodon",
    "Audience": "Fileodon",
    "TokenValidityInMinutes": 60,
    "RefreshTokenValidityInDays": 30
  }
}