#DATABASE
# The IP or hostname of the database server
DB__HOST=
# The port number of the database server
DB__PORT=
# The username to connect to the database
DB__USER=
# The password to connect to the database
DB__PASSWORD=
# The name of the database to connect to
DB__NAME=

#API
# The base URL of the API server. This is used for generating links in emails and other communications.
# Remember to include the protocol (http or https) and the port number if it's not the default (80 for http, 443 for https).
API__HOST=

#JWT
# The secret key used to sign and verify JWT tokens
JWT__KEY=

#CORS
# The allowed origins for CORS requests, separated by commas
CORS__ALLOWED_HOSTS=http://localhost:80,https://localhost:443

#SMTP
# The hostname of the SMTP server. Can be an IP address or a domain name.
SMTP__HOST=
# The port number of the SMTP server. Common ports are 25 (non-encrypted), 465 (SSL), and 587 (STARTTLS).
SMTP__PORT=
# Whether to use STARTTLS for the SMTP connection. Set to true or false. False will use SSL instead.
SMTP__STARTTLS=false
# The username for authenticating with the SMTP server. Leave blank if not required.
SMTP__USER=
# The password for authenticating with the SMTP server. Leave blank if not required.
SMTP__PASSWORD=
# The email address that will appear in the 'From' field of outgoing emails. This should be a valid email address.
SMTP__FROM_ADDRESS=